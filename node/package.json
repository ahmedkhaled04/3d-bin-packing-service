{
  "name": "3d-bin-packing-service",
  "version": "1.0.0",
  "description": "Self-hosted 3D bin-packing microservice — Node.js + py3dbp",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev":   "node --watch server.js",
    "test":  "jest --runInBand --forceExit"
  },
  "keywords": ["bin-packing", "logistics", "3d", "supply-chain"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testMatch":  ["**/tests/**/*.test.js"],
    "testTimeout": 30000,
    "verbose":    true
  },
  "dependencies": {
    "dotenv":   "^18.0.3",
    "express":  "^5.2.1",
    "joi":      "^18.2.9"
  },
  "devDependencies": {
    "jest":      "^30.5.2",
    "supertest": "^7.3.0"
  }
}
